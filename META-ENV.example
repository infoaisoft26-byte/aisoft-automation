# Copy these names into Vercel → Project → Settings → Environment Variables.
# Set real values in Vercel only. Do not commit secrets or a filled .env file.

META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://aisoft-automation.vercel.app/api/meta/oauth/callback
META_ADMIN_KEY=
META_TOKEN_ENCRYPTION_KEY=
DATABASE_URL=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0

# Optional: leave blank until Meta Pixel is created and consent setup is reviewed.
META_PIXEL_ID=

# WhatsApp Cloud API (optional until WhatsApp Business is configured)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Generate META_TOKEN_ENCRYPTION_KEY with: openssl rand -hex 32
# META_ADMIN_KEY and META_WEBHOOK_VERIFY_TOKEN must each be long random values (32+ chars).
# Never expose META_APP_SECRET, WHATSAPP_ACCESS_TOKEN, DATABASE_URL, META_ADMIN_KEY,
# or META_TOKEN_ENCRYPTION_KEY in client-side HTML or JavaScript.
